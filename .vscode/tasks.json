{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "java (build)",
			"paths": [
				"${workspace}"
			],
			"isFullBuild": false,
			"group": "build",
			"problemMatcher": [],
			"label": "java (build): Build Workspace",
			"detail": "$(tools) Build all the Java projects in workspace."
		},
		{
			"type": "npm",
			"script": "build",
			"path": "frontend",
			"group": "build",
			"problemMatcher": [],
			"label": "npm: build - frontend",
			"detail": "tsc -b && vite build"
		},
		{
			"label": "dev env launch",
			"type": "shell",
			"command": "./scripts/build_dev.sh && docker-compose up -d",
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"options": {
				"env": {
					"JAVA_HOME": "/usr/lib/jvm/java-21-temurin-jdk"
				}
			},
			"runOptions": {
				"runOn": "folderOpen",
				"instanceLimit": 1,
				"instancePolicy": "prompt"
			}
		},
	]
}